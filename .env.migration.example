# ============================================
# MIGRATION CAMPAIGN ENVIRONMENT VARIABLES
# ============================================

# Resend Webhooks (CRITICAL for email tracking)
# Get this from Resend dashboard > Webhooks > Create webhook
# Set webhook URL to: https://liefdevooriedereen.nl/api/webhooks/resend
# Events to select: email.delivered, email.opened, email.clicked, email.bounced, email.complained
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Admin Alerts
# Email address to receive migration campaign alerts
ADMIN_EMAIL=admin@liefdevooriedereen.nl

# Feature Flags
ENABLE_AB_TESTING=true
ENABLE_AUTO_FOLLOWUP=true

# Redis (should already be configured)
REDIS_URL=your_redis_url_here
